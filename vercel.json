{
  "version": 2,
  "builds": [
    {
      "src": "api/chat.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/info-public.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/supabase-test.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/user.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/trip.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/payment.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/chat",
      "dest": "/api/chat.js"
    },
    {
      "src": "/api/info-public",
      "dest": "/api/info-public.js"
    },
    {
      "src": "/api/supabase-test",
      "dest": "/api/supabase-test.js"
    },
    {
      "src": "/api/user",
      "dest": "/api/user.js"
    },
    {
      "src": "/api/trip",
      "dest": "/api/trip.js"
    },
    {
      "src": "/api/payment",
      "dest": "/api/payment.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
