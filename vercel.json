{
  "version": 2,
  "builds": [
    { "src": "api/platform-config.js", "use": "@vercel/node" },
    { "src": "api/feedback.js", "use": "@vercel/node" },
    { "src": "api/travel-intelligence.js", "use": "@vercel/node" },
    { "src": "api/itinerary-changes.js", "use": "@vercel/node" },
    {
      "src": "api/chat.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/info-public.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/supabase-test.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/user.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/trip.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/payment.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/promotions.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/destination-suggestions.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/context.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/events.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/attribution.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/partners.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "api/data/omio-es.csv.gz",
          "api/data/omio-en.csv.gz"
        ]
      }
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/platform-config", "dest": "/api/platform-config.js" },
    { "src": "/api/feedback", "dest": "/api/feedback.js" },
    { "src": "/api/travel-intelligence", "dest": "/api/travel-intelligence.js" },
    { "src": "/api/itinerary-changes", "dest": "/api/itinerary-changes.js" },
    {
      "src": "/api/chat",
      "dest": "/api/chat.js"
    },
    {
      "src": "/api/info-public",
      "dest": "/api/info-public.js"
    },
    {
      "src": "/api/supabase-test",
      "dest": "/api/supabase-test.js"
    },
    {
      "src": "/api/user",
      "dest": "/api/user.js"
    },
    {
      "src": "/api/trip",
      "dest": "/api/trip.js"
    },
    {
      "src": "/api/payment",
      "dest": "/api/payment.js"
    },
    {
      "src": "/api/promotions",
      "dest": "/api/promotions.js"
    },
    {
      "src": "/api/destination-suggestions",
      "dest": "/api/destination-suggestions.js"
    },
    {
      "src": "/api/context",
      "dest": "/api/context.js"
    },
    {
      "src": "/api/events",
      "dest": "/api/events.js"
    },
    {
      "src": "/api/attribution",
      "dest": "/api/attribution.js"
    },
    {
      "src": "/api/partners",
      "dest": "/api/partners.js"
    },
    {
      "src": "/api/email",
      "dest": "/api/user.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
