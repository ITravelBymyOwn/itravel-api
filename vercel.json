{
  "version": 2,
  "builds": [
    {
      "src": "api/platform.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/chat.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/info-public.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/user.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/trip.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/payment.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/promotions.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/destination-suggestions.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "api/data/destinations.v2.json.gz"
        ]
      }
    },
    {
      "src": "api/context.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/events.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/attribution.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/partners.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "api/data/omio-es.csv.gz",
          "api/data/omio-en.csv.gz"
        ]
      }
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/platform-config",
      "dest": "/api/platform.js?endpoint=platform-config"
    },
    {
      "src": "/api/feedback",
      "dest": "/api/platform.js?endpoint=feedback"
    },
    {
      "src": "/api/travel-intelligence",
      "dest": "/api/platform.js?endpoint=travel-intelligence"
    },
    {
      "src": "/api/itinerary-changes",
      "dest": "/api/platform.js?endpoint=itinerary-changes"
    },
    {
      "src": "/api/chat",
      "dest": "/api/chat.js"
    },
    {
      "src": "/api/info-public",
      "dest": "/api/info-public.js"
    },
    {
      "src": "/api/supabase-test",
      "dest": "/api/platform.js?endpoint=supabase-test"
    },
    {
      "src": "/api/user",
      "dest": "/api/user.js"
    },
    {
      "src": "/api/trip",
      "dest": "/api/trip.js"
    },
    {
      "src": "/api/payment",
      "dest": "/api/payment.js"
    },
    {
      "src": "/api/promotions",
      "dest": "/api/promotions.js"
    },
    {
      "src": "/api/destination-suggestions",
      "dest": "/api/destination-suggestions.js"
    },
    {
      "src": "/api/context",
      "dest": "/api/context.js"
    },
    {
      "src": "/api/events",
      "dest": "/api/events.js"
    },
    {
      "src": "/api/attribution",
      "dest": "/api/attribution.js"
    },
    {
      "src": "/api/partners",
      "dest": "/api/partners.js"
    },
    {
      "src": "/api/email",
      "dest": "/api/user.js"
    },
    {
      "src": "^/$",
      "dest": "/public/preview-home.html"
    },
    {
      "src": "^/english/?$",
      "dest": "/public/preview-home-en.html"
    },
    {
      "src": "^/como-funciona/?$",
      "dest": "/public/como-funciona.html"
    },
    {
      "src": "^/ejemplo-itinerario/?$",
      "dest": "/public/ejemplo-itinerario.html"
    },
    {
      "src": "^/precios/?$",
      "dest": "/public/precios.html"
    },
    {
      "src": "^/acerca-de-itbmo/?$",
      "dest": "/public/acerca-de-itbmo.html"
    },
    {
      "src": "^/how-it-works/?$",
      "dest": "/public/how-it-works.html"
    },
    {
      "src": "^/sample-itinerary/?$",
      "dest": "/public/sample-itinerary.html"
    },
    {
      "src": "^/pricing/?$",
      "dest": "/public/pricing.html"
    },
    {
      "src": "^/about-itbmo/?$",
      "dest": "/public/about-itbmo.html"
    },
    {
      "src": "^/destinos/?$",
      "dest": "/public/destinos.html"
    },
    {
      "src": "^/destinations/?$",
      "dest": "/public/destinations.html"
    },
    {
      "src": "^/recursos/?$",
      "dest": "/public/recursos.html"
    },
    {
      "src": "^/resources/?$",
      "dest": "/public/resources.html"
    },
    {
      "src": "^/colabora/?$",
      "dest": "/public/colabora.html"
    },
    {
      "src": "^/partner-with-itbmo/?$",
      "dest": "/public/partner-with-itbmo.html"
    },
    {
      "src": "^/soporte-contacto/?$",
      "dest": "/public/support-contact.html"
    },
    {
      "src": "^/support-contact/?$",
      "dest": "/public/support-contact-en.html"
    },
    {
      "src": "^/privacidad-cookies/?$",
      "dest": "/public/privacy-cookies.html"
    },
    {
      "src": "^/privacy-cookies/?$",
      "dest": "/public/privacy-cookies-en.html"
    },
    {
      "src": "^/terminos/?$",
      "dest": "/public/terms.html"
    },
    {
      "src": "^/terms/?$",
      "dest": "/public/terms-en.html"
    },
    {
      "src": "^/publicidad-afiliados/?$",
      "dest": "/public/ads-affiliates.html"
    },
    {
      "src": "^/advertising-affiliates/?$",
      "dest": "/public/ads-affiliates-en.html"
    },
    {
      "src": "^/planner/?$",
      "dest": "/public/planner.html"
    },
    {
      "src": "^/trip-workspace/?$",
      "dest": "/public/trip-workspace.html"
    },
    {
      "src": "^/destinos/(paris|roma|santorini|islandia|estambul|rio-de-janeiro|bariloche|egipto|tromso|patagonia)/?$",
      "dest": "/public/destino-$1.html"
    },
    {
      "src": "^/destinations/(paris|rome|santorini|iceland|istanbul|rio-de-janeiro|bariloche|egypt|tromso|patagonia)/?$",
      "dest": "/public/destination-$1.html"
    },
    {
      "src": "^/sitemap-v297.xml$",
      "dest": "/public/sitemap-v297.xml"
    },
    {
      "src": "^/sitemap.xml$",
      "dest": "/public/sitemap-v297.xml"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
